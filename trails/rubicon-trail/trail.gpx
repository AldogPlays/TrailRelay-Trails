<?xml version="1.0"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.1" creator="AllTrails.com" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name><![CDATA[Rubicon Trail]]></name>
    <desc><![CDATA[]]></desc>
    <link href="http://www.alltrails.com">
      <text>AllTrails, LLC</text>
    </link>
    <bounds minlat="39.00317" minlon="-120.31277" maxlat="39.07046" maxlon="-120.14023"/>
  </metadata>
  <wpt lat="39.0035" lon="-120.30983">
    <name><![CDATA[Ice House Road]]></name>
    <desc><![CDATA[Bear left at end of Ice House Road and drop down to Loon Lake Staging Area.]]></desc>
  </wpt>
  <wpt lat="39.0040981" lon="-120.3127064">
    <name><![CDATA[Staging Area]]></name>
    <desc><![CDATA[Prepare to enter trail here. Good place to air down and tie down everything.]]></desc>
  </wpt>
  <wpt lat="39.01952" lon="-120.38038">
    <name><![CDATA[Wentworth Springs Road Trailhead]]></name>
    <desc><![CDATA[This is one of the popular starting points for the Rubicon Trail.]]></desc>
  </wpt>
  <wpt lat="39.0053677" lon="-120.3085183">
    <name><![CDATA[The Gate Keeper]]></name>
    <desc><![CDATA[If you can't get through here, you'd better turn around. It only gets worse.]]></desc>
  </wpt>
  <wpt lat="39.0134164" lon="-120.307722">
    <name><![CDATA[Trail Marker on Tree]]></name>
    <desc><![CDATA[Note trail marker. There aren't many, but they help.]]></desc>
  </wpt>
  <wpt lat="39.0183079" lon="-120.3084992">
    <name><![CDATA[ Wentworth Springs Road]]></name>
    <desc><![CDATA[Merge onto Wentworth Springs Road which joins on left. Trail is more defined now, but it has some tough spots.]]></desc>
  </wpt>
  <wpt lat="39.0208246" lon="-120.2757833">
    <name><![CDATA[Entrance to Little Sluice]]></name>
    <desc><![CDATA[The Little Sluice Box is an extreme obstacle that changes over time as boulders move around. Only the most aggressive vehicles should attempt it. Stay left to bypass this obstacle.]]></desc>
  </wpt>
  <wpt lat="39.00712" lon="-120.26173">
    <name><![CDATA[Exit Point of True Big Sluice]]></name>
    <desc><![CDATA[Stay left here at exit point of True Big Sluice. Sorry, this skips the entry point. This obstacle is tougher than the Little Sluice, as the name implies.]]></desc>
  </wpt>
  <wpt lat="39.00567" lon="-120.25709">
    <name><![CDATA[Camp Spot - On Right]]></name>
    <desc><![CDATA[On the right below the dam for Buck Island Lake is a great camp spot. This spot is often occupied.]]></desc>
  </wpt>
  <wpt lat="39.00411" lon="-120.24442">
    <name><![CDATA[Enter - The Big Sluice]]></name>
    <desc><![CDATA[A sharp switchback to the left marks the beginning of the Big Sluice, not to be confused with the True Big Sluice mentioned earlier. You cannot bypass this section of very large and tight boulders.]]></desc>
  </wpt>
  <wpt lat="39.0125577" lon="-120.2449131">
    <name><![CDATA[ Rubicon Bridge]]></name>
    <desc><![CDATA[After a nasty mud hole, you cross Rubicon Bridge and enter Rubicon Springs, a popular fee camping area.]]></desc>
  </wpt>
  <wpt lat="39.01663" lon="-120.24507">
    <name><![CDATA[Rubicon Springs]]></name>
    <desc><![CDATA[Stay left here and pass through Rubicon Springs, a fee camping area. Straight here is insane. You'll circle around Rubicon Springs and go by a helicopter pad. Rubicon Springs is a major control center for Jeep Jamborees that are held here annually. Don't drive the Rubicon Trail during a Jeep Jamboree.]]></desc>
  </wpt>
  <wpt lat="39.024602" lon="-120.2497129">
    <name><![CDATA[Close to River]]></name>
    <desc><![CDATA[Stay on northeast side of river unless you want to camp on other side. River is usually shallow enough to cross.]]></desc>
  </wpt>
  <wpt lat="39.0306019" lon="-120.2526435">
    <name><![CDATA[Cadillac Hill]]></name>
    <desc><![CDATA[Begin steep, rocky, narrow climb up Cadillac Hill.]]></desc>
  </wpt>
  <wpt lat="39.03718" lon="-120.22248">
    <name><![CDATA[Ellis Peak - Trail on Left]]></name>
    <desc><![CDATA[Stay right here where Blackwood Canyon/Ellis Peak Trail joins on left.]]></desc>
  </wpt>
  <wpt lat="39.0459493" lon="-120.1681953">
    <name><![CDATA[Rubicon Staging Area]]></name>
    <desc><![CDATA[Large staging area for vehicles entering Rubicon Trail from Lake Tahoe side. Most people drive the trail in the direction described here even though it's a long highway drive to start at Loon Lake. The shortest highway drive would be to start in Lake Tahoe and drive the Rubicon in both directions.]]></desc>
  </wpt>
  <wpt lat="39.0703154" lon="-120.1403586">
    <name><![CDATA[Highway 89]]></name>
    <desc><![CDATA[Intersect with Highway 89, West Lake Boulevard, which winds around western shore of Lake Tahoe. Bear left for Tahoe City, Truckee and Interstate 80.]]></desc>
  </wpt>
  <trk>
    <name><![CDATA[Rubicon Trail]]></name>
    <src>AllTrails</src>
